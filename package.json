{
  "name": "ass-html5",
  "version": "0.7.1",
  "description": "Display ASS/SSA subtitles on html5 videos",
  "main": "dist/ass.js",
  "module": "dist/ass.js",
  "types": "dist/ass.d.ts",
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "build": "pnpm run build:worker && pnpm run lint && pnpm run build:normal && pnpm run build:minify",
    "build:normal": "tsdown",
    "build:minify": "rolldown -c",
    "dev": "tsdown --watch",
    "release": "pnpm run build && changeset publish",
    "lint": "tsc",
    "test": "vitest",
    "format": "prettier --write ."
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxluth/ass-html5.git"
  },
  "keywords": [
    "ASS",
    "SSA",
    "subtitles",
    "aegisub",
    "libass"
  ],
  "author": "luxluth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/luxluth/ass-html5/issues"
  },
  "homepage": "https://github.com/luxluth/ass-html5#readme",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.5.0",
    "ass-compiler": "^0.1.16",
    "canvas": "^3.2.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "rolldown": "^1.2.16",
    "terser": "^5.46.1",
    "tsdown": "^0.23.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
